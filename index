            localStorage.setItem(CART_KEY, JSON.stringify(items));
            window.dispatchEvent(new StorageEvent('storage', { key: CART_KEY, newValue: JSON.stringify(items),
                storageArea: localStorage }));
            updateCartUI(items);
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            const iconMap = { success: 'fa-check-circle', warning: 'fa-exclamation-triangle', error: 'fa-exclamation-circle' };
            toast.innerHTML =
                `<span class="toast-icon"><i class="fas ${iconMap[type] || 'fa-info-circle'}"></i></span><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0';
                toast.style.transform = 'translateX(50px)';
                setTimeout(() => toast.remove(), 400); }, 4000);
        }

        // =============================================================
        // 2. CUSTOMER VIEW FUNCTIONS
        // =============================================================
        let currentView = 'products';
        let activeCategory = 'all';
        let activePriceRange = 'all';
        let wishlist = JSON.parse(localStorage.getItem('favlor_wishlist') || '[]');
        let compareList = JSON.parse(localStorage.getItem('favlor_compare') || '[]');
        let currentProduct = null;
        let currentModalImages = [];
        let currentModalImageIndex = 0;

        function switchView(view) {
            currentView = view;
            document.getElementById('viewProducts').classList.toggle('hidden', view !== 'products');
            document.getElementById('viewOrders').classList.toggle('active', view === 'orders');
            document.getElementById('shopBtn').classList.toggle('active', view === 'products');
            document.getElementById('ordersBtn').classList.toggle('active', view === 'orders');
            document.getElementById('headerCategoryMenu').style.display = view === 'products' ? 'block' : 'none';
            document.getElementById('headerSearchBtn').style.display = view === 'products' ? 'flex' : 'none';
            if (view !== 'products') {
                closeCategoryMenu();
                closeHeaderSearch();
            }
            if (view === 'orders') renderOrders();
        }

        function selectPriceRange(range) {
            activePriceRange = range;
            document.querySelectorAll('#priceFilterList .price-item').forEach(el => {
                el.classList.toggle('active', el.dataset.price === range);
            });
            document.getElementById('priceFilterToggle').classList.toggle('filtered', range !== 'all');
            applyFilters();
            closePriceFilter();
        }

        function togglePriceFilter(e) {
            e.stopPropagation();
            closeCategoryMenu();
            closeSortPopup();
            const popup = document.getElementById('priceFilterPopup');
            const button = document.getElementById('priceFilterToggle');
            const willOpen = !popup.classList.contains('open');
            popup.classList.toggle('open', willOpen);
            button.classList.toggle('active', willOpen);
            button.setAttribute('aria-expanded', String(willOpen));
        }

        function closePriceFilter() {
            const popup = document.getElementById('priceFilterPopup');
            const button = document.getElementById('priceFilterToggle');
            popup.classList.remove('open');
            button.classList.remove('active');
            button.setAttribute('aria-expanded', 'false');
        }

        function toggleSortPopup(e) {
            e.stopPropagation();
            closeCategoryMenu();
            closePriceFilter();
            const popup = document.getElementById('sortPopup');
            const button = document.getElementById('sortToggle');
            const willOpen = !popup.classList.contains('open');
            popup.classList.toggle('open', willOpen);
            button.classList.toggle('active', willOpen);
            button.setAttribute('aria-expanded', String(willOpen));
        }

        function closeSortPopup() {
            const popup = document.getElementById('sortPopup');
            const button = document.getElementById('sortToggle');
            popup.classList.remove('open');
            button.classList.remove('active');
            button.setAttribute('aria-expanded', 'false');
        }

        function applySortSelection() {
            const select = document.getElementById('sortBy');
            document.getElementById('sortToggle').classList.toggle('sorted', select.value !== 'default');
            applyFilters();
            closeSortPopup();
        }

        function toggleHeaderSearch(e) {
            e.stopPropagation();
            closeCategoryMenu();
            closePriceFilter();
            closeSortPopup();
            document.getElementById('userDropdown').classList.remove('open');
            const panel = document.getElementById('headerSearchPanel');
            const button = document.getElementById('headerSearchBtn');
            const willOpen = !panel.classList.contains('open');
            panel.classList.toggle('open', willOpen);
            button.classList.toggle('active', willOpen);
            button.setAttribute('aria-expanded', String(willOpen));
            if (willOpen) document.getElementById('searchInputTop').focus();
        }

        function closeHeaderSearch() {
            const panel = document.getElementById('headerSearchPanel');
            const button = document.getElementById('headerSearchBtn');
            panel.classList.remove('open');
            button.classList.remove('active');
            button.setAttribute('aria-expanded', 'false');
            closePriceFilter();
            closeSortPopup();
        }

        document.addEventListener('click', closePriceFilter);
        document.addEventListener('click', closeSortPopup);
        document.addEventListener('click', closeHeaderSearch);

        function clearSearch() {
            document.getElementById('searchInputTop').value = '';
            document.getElementById('clearSearchTop').classList.add('hidden');
            applyFilters();
        }

        function applyFilters() {
            const products = getProducts();
            const container = document.getElementById('productHorizontal');
            const resultCount = document.getElementById('resultCount');
            const searchTerm = document.getElementById('searchInputTop').value.toLowerCase().trim();

            let filtered = products.filter(p => {
                const cat = p.category || 'Other';
                return activeCategory === 'all' || cat === activeCategory;
            });

            if (searchTerm) {
                filtered = filtered.filter(p => p.name.toLowerCase().includes(searchTerm) || (p.description && p.description
                    .toLowerCase().includes(searchTerm)));
            }

            if (activePriceRange !== 'all') {
                filtered = filtered.filter(p => {
                    const price = p.price;
                    switch (activePriceRange) {
                        case '100-500':
                            return price >= 100 && price <= 500;
                        case '500-1000':
                            return price >= 500 && price <= 1000;
                        case '1000-5000':
                            return price >= 1000 && price <= 5000;
                        case '5000+':
                            return price >= 5000;
                        default:
                            return true;
                    }
                });
            }

            const sortValue = document.getElementById('sortBy').value;
            switch (sortValue) {
                case 'newest':
                    filtered.sort((a, b) => new Date(b.dateAdded) - new Date(a.dateAdded));
                    break;
                case 'price-low':
                    filtered.sort((a, b) => a.price - b.price);
                    break;
                case 'price-high':
                    filtered.sort((a, b) => b.price - a.price);
                    break;
                case 'rating':
                    filtered.sort((a, b) => (b.rating || 0) - (a.rating || 0));
                    break;
                case 'selling':
                    filtered.sort((a, b) => (b.soldCount || 0) - (a.soldCount || 0));
                    break;
                default:
                    filtered.sort((a, b) => a.name.localeCompare(b.name));
                    break;
            }

            renderCategoryList(products);

            if (filtered.length === 0) {
                container.innerHTML =
                    `<div class="empty-state-h"><i class="fas fa-box-open"></i><h3>No products found</h3><p>Try adjusting your filters.</p></div>`;
                resultCount.textContent = '';
                return;
            }
            resultCount.textContent = `${filtered.length} product${filtered.length > 1 ? 's' : ''}`;

            container.innerHTML = filtered.map(p => {
                const inWishlist = wishlist.includes(p.id);
                const inCompare = compareList.includes(p.id);
                const isOutOfStock = productAvailability(p) === 'out_of_stock';
                const discountHtml = p.discount ? `<span class="discount-badge">${p.discount}% OFF</span>` : '';
                const stars = '★'.repeat(Math.floor(p.rating || 0)) + '☆'.repeat(5 - Math.floor(p.rating || 0));
                // No stock badge on image
                return `<div class="product-card-h" data-id="${p.id}">
                            <div class="image-wrapper">
                                <img class="card-img" src="${p.image || 'data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27400%27%20height%3D%27200%27%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20fill%3D%27%23e5e7eb%27%2F%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2750%25%27%20font-family%3D%27Arial%2Csans-serif%27%20font-size%3D%2716%27%20fill%3D%27%236b7280%27%20text-anchor%3D%27middle%27%20dominant-baseline%3D%27middle%27%3ENo%20Image%3C%2Ftext%3E%3C%2Fsvg%3E'}" alt="${p.name}" onerror="this.src='data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27400%27%20height%3D%27200%27%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20fill%3D%27%23e5e7eb%27%2F%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2750%25%27%20font-family%3D%27Arial%2Csans-serif%27%20font-size%3D%2716%27%20fill%3D%27%236b7280%27%20text-anchor%3D%27middle%27%20dominant-baseline%3D%27middle%27%3ENo%20Image%3C%2Ftext%3E%3C%2Fsvg%3E'">
                                ${discountHtml}
                                <div class="card-actions-top">
                                    <button class="card-action-btn ${inWishlist ? 'wishlist-active' : ''}" onclick="event.stopPropagation(); toggleWishlist(${p.id})" title="Wishlist"><i class="fas ${inWishlist ? 'fa-heart' : 'fa-heart'}"></i></button>
                                    <button class="card-action-btn ${inCompare ? 'compare-active' : ''}" onclick="event.stopPropagation(); toggleCompare(${p.id})" title="Compare"><i class="fas fa-balance-scale"></i></button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="product-brand">${escapeHtml(p.brand || 'Favlor')}</div>
                                <div class="product-name">${escapeHtml(p.name)}</div>
                                <span class="product-category">${escapeHtml(p.category || 'Other')}</span>
                                <div class="product-rating"><span class="stars">${stars}</span><span class="review-count">(${p.reviewCount || 0})</span></div>
                                <div class="product-price-row">
                                    <span class="product-price">${getSettings().currencySymbol || '₹'}${Number(p.price).toFixed(2)} <span>INR</span></span>
                                    ${p.originalPrice ? `<span class="product-original-price">${getSettings().currencySymbol || '₹'}${Number(p.originalPrice).toFixed(2)}</span>` : ''}
                                    ${p.discount ? `<span class="product-discount-percent">${p.discount}% OFF</span>` : ''}
                                </div>
                                <div class="card-actions-bottom">
                                    <button class="btn-add-cart" onclick="event.stopPropagation(); addItemToCart(${JSON.stringify(p).replace(/"/g, '&quot;')})" ${isOutOfStock ? 'disabled' : ''}><i class="fas fa-cart-plus"></i> Add</button>
                                    <button class="btn-buy-now" onclick="event.stopPropagation(); addItemToCart(${JSON.stringify(p).replace(/"/g, '&quot;')}); openCheckoutForm();" ${isOutOfStock ? 'disabled' : ''}><i class="fas fa-bolt"></i> Buy</button>
                                </div>
                            </div>
                        </div>`;
            }).join('');

            document.querySelectorAll('.product-card-h').forEach(card => {
                card.addEventListener('click', function() {
                    const id = parseInt(this.dataset.id);
                    const product = filtered.find(p => p.id === id);
                    if (product) openModal(product);
                });
            });
        }

        function renderCategoryList(products) {
            const container = document.getElementById('categoryList');
            const counts = {};
            products.forEach(p => { const cat = p.category || 'Other';
                counts[cat] = (counts[cat] || 0) + 1; });
            const sortedCats = Object.keys(counts).sort();
            let html =
                `<div class="cat-item ${activeCategory === 'all' ? 'active' : ''}" data-category="all" onclick="selectCategory('all')"><span class="cat-icon"><i class="fas fa-th-list"></i></span> All Categories <span class="cat-count">${products.length}</span></div>`;
            sortedCats.forEach(cat => {
                html +=
                    `<div class="cat-item ${activeCategory === cat ? 'active' : ''}" data-category="${escapeHtml(cat)}" onclick="selectCategory('${escapeHtml(cat)}')"><span class="cat-icon"><i class="fas fa-tag"></i></span> ${escapeHtml(cat)} <span class="cat-count">${counts[cat]}</span></div>`;
            });
            container.innerHTML = html;
        }

        function selectCategory(category) {
            activeCategory = category;
            document.querySelectorAll('.cat-item').forEach(el => el.classList.toggle('active', el.dataset.category ===
            category));
            applyFilters();
            closeCategoryMenu();
        }

        function toggleCategoryMenu(e) {
            e.stopPropagation();
            closeHeaderSearch();
            closePriceFilter();
            closeSortPopup();
            document.getElementById('userDropdown').classList.remove('open');
            const dropdown = document.getElementById('categoryDropdown');
            const button = document.getElementById('categoryMenuBtn');
            const willOpen = !dropdown.classList.contains('open');
            dropdown.classList.toggle('open', willOpen);
            button.classList.toggle('active', willOpen);
            button.setAttribute('aria-expanded', String(willOpen));
        }

        function closeCategoryMenu() {
            const dropdown = document.getElementById('categoryDropdown');
            const button = document.getElementById('categoryMenuBtn');
            dropdown.classList.remove('open');
            button.classList.remove('active');
            button.setAttribute('aria-expanded', 'false');
        }

        document.addEventListener('click', closeCategoryMenu);

        document.getElementById('searchInputTop').addEventListener('input', applyFilters);

        // ----- CART -----
        function updateCartUI(items) {
            const countEl = document.getElementById('cartCount');
            const total = items.reduce((sum, item) => sum + item.quantity, 0);
            if (countEl) {
                countEl.textContent = total;
                countEl.classList.remove('bump');
                void countEl.offsetWidth;
                countEl.classList.add('bump');
            }
            if (document.getElementById('cartModal').classList.contains('active')) renderCartModal(items);
        }

        function renderCartModal(items) {
            const container = document.getElementById('cartItems');
            const totalEl = document.getElementById('cartTotal');
            const checkoutBtn = document.getElementById('checkoutBtn');
            if (items.length === 0) {
                container.innerHTML =
                    `<div class="empty-cart"><i class="fas fa-shopping-bag"></i><h3>Your cart is empty</h3></div>`;
                totalEl.textContent = '₹0.00';
                checkoutBtn.disabled = true;
                return;
            }
            container.innerHTML = items.map(item =>
                `<div class="cart-item"><img class="item-img" src="${item.image}" alt="${item.name}" onerror="this.src='data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2760%27%20height%3D%2760%27%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20fill%3D%27%23e5e7eb%27%2F%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2750%25%27%20font-family%3D%27Arial%2Csans-serif%27%20font-size%3D%279%27%20fill%3D%27%236b7280%27%20text-anchor%3D%27middle%27%20dominant-baseline%3D%27middle%27%3ENo%20Image%3C%2Ftext%3E%3C%2Fsvg%3E'"><div class="item-details"><div class="item-name">${escapeHtml(item.name)}</div><div class="item-price">${getSettings().currencySymbol || '₹'}${Number(item.price).toFixed(2)}</div></div><div class="item-qty"><button onclick="removeItemFromCart(${item.id})">−</button><span class="qty-num">${item.quantity}</span><button onclick="addOneMore(${item.id})">+</button></div><button class="item-remove" onclick="deleteItemFromCart(${item.id})"><i class="fas fa-trash"></i></button></div>`
            ).join('');
            const total = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
            totalEl.textContent = `${getSettings().currencySymbol || '₹'}${total.toFixed(2)}`;
            checkoutBtn.disabled = false;
        }

        function addItemToCart(product) {
            if (productAvailability(product) === 'out_of_stock') {
                showToast('⚠️ This product is out of stock.', 'warning');
                return;
            }
            if (productAvailability(product) === 'pre_order') {
                showToast('📦 Pre-order item added to cart.', 'warning');
            }
            let items = getCartItems();
            const existing = items.find(i => i.id === product.id);
            if (existing) existing.quantity += 1;
            else items.push({ id: product.id, name: product.name, price: product.price, image: product.image ||
                    'data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2760%27%20height%3D%2760%27%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20fill%3D%27%23e5e7eb%27%2F%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2750%25%27%20font-family%3D%27Arial%2Csans-serif%27%20font-size%3D%279%27%20fill%3D%27%236b7280%27%20text-anchor%3D%27middle%27%20dominant-baseline%3D%27middle%27%3ENo%20Image%3C%2Ftext%3E%3C%2Fsvg%3E', quantity: 1 });
            saveCartItems(items);
            showToast(`🛒 "${product.name}" added to cart!`, 'success');
        }

        function removeItemFromCart(id) {
            let items = getCartItems();
            const idx = items.findIndex(i => i.id === id);
            if (idx === -1) return;
            if (items[idx].quantity > 1) items[idx].quantity -= 1;
            else items.splice(idx, 1);
            saveCartItems(items);
            renderCartModal(items);
        }

        function deleteItemFromCart(id) {
            let items = getCartItems();
            items = items.filter(i => i.id !== id);
            saveCartItems(items);
            renderCartModal(items);
        }

        function addOneMore(id) {
            let items = getCartItems();
            const item = items.find(i => i.id === id);
            if (item) {
                const products = getProducts();
                const product = products.find(p => p.id === id);
                if (product) addItemToCart(product);
                else { item.quantity += 1;
                    saveCartItems(items);
                    renderCartModal(items); }
            }
        }

        function openCartModal() {
            const items = getCartItems();
            document.getElementById('cartModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            renderCartModal(items);
        }

        function closeCartModal() {
            document.getElementById('cartModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function openCheckoutForm() {
            const items = getCartItems();
            if (items.length === 0) { showToast('Cart is empty!', 'warning'); return; }
            if (!isLoggedIn()) { showToast('Please login to checkout.', 'warning');
                openAuthModal('login'); return; }
            const user = getCurrentUser();
            if (user) {
                document.getElementById('custName').value = user.name;
                document.getElementById('custEmail').value = user.email;
                if (user.phone) document.getElementById('custPhone').value = user.phone;
            }
            closeCartModal();
            const total = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
            document.getElementById('checkoutTotal').textContent = `${getSettings().currencySymbol || '₹'}${total.toFixed(2)}`;
            document.getElementById('checkoutModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeCheckoutForm() {
            document.getElementById('checkoutModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function placeOrder(e) {
            e.preventDefault();
            if (!isLoggedIn()) { showToast('Please login.', 'warning');
                closeCheckoutForm();
                openAuthModal('login'); return; }
            const name = document.getElementById('custName').value.trim();
            const email = document.getElementById('custEmail').value.trim();
            const phone = document.getElementById('custPhone').value.trim();
            const address = document.getElementById('custAddress').value.trim();
            const notes = document.getElementById('custNotes').value.trim();
            if (!name || !email || !phone || !address) { showToast('Fill all required fields.', 'warning'); return; }
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showToast('Invalid email.', 'warning'); return; }
            if (!/^[0-9]{10}$/.test(phone.replace(/[^0-9]/g, ''))) { showToast('Invalid phone.', 'warning'); return; }
            const items = getCartItems();
            const total = items.reduce((sum, i) => sum + i.price * i.quantity, 0);
            const order = {
                id: 'FLRS-' + Date.now().toString().slice(-8),
                customer: { name, email, phone, address, notes: notes || '' },
                items: items.map(i => ({ id: i.id, name: i.name, price: i.price, quantity: i.quantity, image: i
                        .image })),
                total: total,
                status: 'Pending',
                date: new Date().toISOString(),
                deliveryDate: null
            };
            let orders = getOrders();
            orders.push(order);
            saveOrders(orders);
            saveCartItems([]);
            closeCheckoutForm();
            switchView('orders');
            renderOrders();
            showToast(`✅ Order placed! ID: ${order.id}`, 'success');
        }

        function renderOrders() {
            const orders = getOrders();
            const container = document.getElementById('ordersContainer');
            const countEl = document.getElementById('ordersCount');
            if (orders.length === 0) {
                container.innerHTML =
                    `<div class="empty-orders"><i class="fas fa-box-open"></i><h3>No orders yet</h3></div>`;
                countEl.textContent = '';
                return;
            }
            orders.sort((a, b) => new Date(b.date) - new Date(a.date));
            countEl.textContent = `${orders.length} order${orders.length > 1 ? 's' : ''}`;
            container.innerHTML = orders.map(o => `
                <div class="order-card">
                    <div class="order-header">
                        <span class="order-id"><i class="fas fa-hashtag"></i> ${escapeHtml(o.id)}</span>
                        <span class="order-date"><i class="far fa-calendar-alt"></i> ${new Date(o.date).toLocaleDateString('en-IN')}</span>
                        ${o.deliveryDate ? `<span class="delivery-date-info"><i class="fas fa-calendar-check"></i> Est. Delivery: ${new Date(o.deliveryDate).toLocaleDateString('en-IN')}</span>` : ''}
                        <span class="order-status status-${o.status.toLowerCase()}"><i class="fas ${o.status === 'Pending' ? 'fa-clock' : o.status === 'Shipped' ? 'fa-truck' : o.status === 'Delivered' ? 'fa-check-circle' : 'fa-times-circle'}"></i> ${o.status}</span>
                    </div>
                    <div class="order-items-preview">
                        ${o.items.slice(0,3).map(item => `<div class="item-preview"><img src="${item.image || 'data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2732%27%20height%3D%2732%27%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20fill%3D%27%23e5e7eb%27%2F%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2750%25%27%20font-family%3D%27Arial%2Csans-serif%27%20font-size%3D%279%27%20fill%3D%27%236b7280%27%20text-anchor%3D%27middle%27%20dominant-baseline%3D%27middle%27%3ENo%20Image%3C%2Ftext%3E%3C%2Fsvg%3E'}" alt="${item.name}" onerror="this.src='data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2732%27%20height%3D%2732%27%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20fill%3D%27%23e5e7eb%27%2F%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2750%25%27%20font-family%3D%27Arial%2Csans-serif%27%20font-size%3D%279%27%20fill%3D%27%236b7280%27%20text-anchor%3D%27middle%27%20dominant-baseline%3D%27middle%27%3ENo%20Image%3C%2Ftext%3E%3C%2Fsvg%3E'">${escapeHtml(item.name)}<span class="qty-badge">×${item.quantity}</span></div>`).join('')}
                        ${o.items.length > 3 ? `<div class="item-preview">+${o.items.length - 3} more</div>` : ''}
                    </div>
                    <div class="order-footer">
                        <div class="order-total">${getSettings().currencySymbol || '₹'}${o.total.toFixed(2)} <span>INR</span></div>
                        <button class="order-details-btn" onclick="showOrderDetail('${o.id}')"><i class="fas fa-eye"></i> View Details</button>
                    </div>
                </div>
            `).join('');
        }

        function showOrderDetail(orderId) {
            const orders = getOrders();
            const order = orders.find(o => o.id === orderId);
            if (!order) { showToast('Order not found!', 'error'); return; }
            const content = document.getElementById('orderDetailContent');
            content.innerHTML = `
                <div><div class="detail-row"><span class="label">Order ID</span><span class="value">${escapeHtml(order.id)}</span></div>
                <div class="detail-row"><span class="label">Status</span><span class="value">${order.status}</span></div>
                <div class="detail-row"><span class="label">Date</span><span class="value">${new Date(order.date).toLocaleDateString('en-IN')}</span></div>
                ${order.deliveryDate ? `<div class="detail-row"><span class="label">Est. Delivery</span><span class="value">${new Date(order.deliveryDate).toLocaleDateString('en-IN')}</span></div>` : ''}
                <div class="detail-row"><span class="label">Customer</span><span class="value">${escapeHtml(order.customer.name)}</span></div>
                <div class="detail-row"><span class="label">Email</span><span class="value">${escapeHtml(order.customer.email)}</span></div>
