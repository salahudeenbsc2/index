        customer: null,
        carts: [],
        cart: [],
        orders: [],
        payments: []
    };
    let customerRealtimeChannel = null;
    let customerReloadTimer = null;

    const readArray = key => {
        try {
            const value = JSON.parse(localStorage.getItem(key) || '[]');
            return Array.isArray(value) ? value : [];
        } catch (_) { return []; }
    };
    const writeArray = (key, value) => localStorage.setItem(key, JSON.stringify(value));

    async function loadCustomerContext() {
        const { data: sessionData } = await supabaseClient.auth.getSession();
        const user = sessionData.session?.user;
        if (!user) {
            customerState.user = null;
            customerState.customer = null;
            return null;
        }
        const { data: customer, error } = await supabaseClient
            .from('customers')
            .select('id,auth_user_id,store_id,full_name,email,phone,address,city,state,pincode,status')
            .eq('auth_user_id', user.id)
            .maybeSingle();
        if (error) throw error;
        if (!customer) throw new Error('Customer profile not found.');
        if (customer.status !== 'Active') throw new Error(`Customer account is ${customer.status}.`);
        customerState.user = user;
        customerState.customer = customer;
        return { user, customer };
    }

    async function requireCustomerLogin() {
        try {
            const context = await loadCustomerContext();
            if (context) return context;
        } catch (error) {
            showToast(error.message || 'Unable to read customer profile.', 'error');
            return null;
        }
        showToast('Please login to continue.', 'warning');
        openAuthModal('login');
        return null;
    }

    function mapCartItem(row, cartStoreId) {
        const product = Array.isArray(row.products) ? row.products[0] : row.products;
        const images = Array.isArray(product?.images) ? product.images.filter(Boolean) : [];
        return {
            _cartItemId: row.id,
            _cartId: row.cart_id,
            id: Number(row.product_id),
            storeId: product?.store_id || cartStoreId,
            name: product?.name || 'Product',
            price: Number(product?.price || 0),
            image: images[0] || PRODUCT_IMAGE_PLACEHOLDER,
            availability: product?.availability || 'in_stock',
            stock: Number(product?.stock_quantity || 0),
            quantity: Number(row.quantity || 1)
        };
    }

    async function loadCustomerCart() {
        if (!customerState.user) return false;
        const { data: carts, error: cartError } = await supabaseClient
            .from('carts').select('id,store_id,status')
            .eq('user_id', customerState.user.id).eq('status', 'active');
        if (cartError) throw cartError;
        customerState.carts = carts || [];
        if (!customerState.carts.length) {
            customerState.cart = [];
        } else {
            const cartIds = customerState.carts.map(cart => cart.id);
            const { data, error } = await supabaseClient
                .from('cart_items')
                .select('id,cart_id,product_id,quantity,products(id,store_id,name,price,images,availability,status,stock_quantity)')
                .in('cart_id', cartIds).order('created_at', { ascending: true });
            if (error) throw error;
            const storeByCart = Object.fromEntries(customerState.carts.map(cart => [cart.id, cart.store_id]));
            customerState.cart = (data || []).map(row => mapCartItem(row, storeByCart[row.cart_id]));
        }
        writeArray(CART_KEY, customerState.cart);
        updateCartUI(customerState.cart);
        return true;
    }

    async function loadCustomerLists() {
        if (!customerState.user) return false;
        const [wishResult, compareResult] = await Promise.all([
            supabaseClient.from('wishlist_items').select('product_id').eq('user_id', customerState.user.id),
            supabaseClient.from('compare_items').select('product_id').eq('user_id', customerState.user.id)
        ]);
        if (wishResult.error) throw wishResult.error;
        if (compareResult.error) throw compareResult.error;
        wishlist = (wishResult.data || []).map(row => Number(row.product_id));
        compareList = (compareResult.data || []).map(row => Number(row.product_id));
        writeArray('favlor_wishlist', wishlist);
        writeArray('favlor_compare', compareList);
        applyFilters();
        return true;
    }

    function mapCustomerOrder(row, payment) {
        return {
            _supabaseId: row.id,
            id: row.order_number || row.id,
            customer: {
                name: row.customer_name || 'Customer',
                email: row.customer_email || '',
                phone: row.customer_phone || '',
                address: row.shipping_address || '',
                notes: row.notes || ''
            },
            items: (row.order_items || []).map(item => ({
                id: Number(item.product_id || 0),
                name: item.product_name || 'Product',
                sku: item.sku || '',
                price: Number(item.unit_price || 0),
                quantity: Number(item.quantity || 1),
                image: item.image_url || PRODUCT_IMAGE_PLACEHOLDER
            })),
            subtotal: Number(row.subtotal || 0),
            discount: Number(row.discount_amount || 0),
            tax: Number(row.tax_amount || 0),
            shipping: Number(row.shipping_amount || 0),
            total: Number(row.total || 0),
            status: row.status || 'Pending',
            paymentMethod: payment?.payment_method || row.payment_method || 'Cash on Delivery',
            paymentStatus: payment?.status || row.payment_status || 'Pending',
            paymentId: payment?.payment_number || '',
            transactionId: payment?.transaction_id || row.transaction_id || '',
            date: row.created_at,
            deliveryDate: row.delivery_date
        };
    }

    async function loadCustomerOrders() {
        if (!customerState.user || !customerState.customer) return false;
        const [orderResult, paymentResult] = await Promise.all([
            supabaseClient.from('orders').select('*,order_items(*)')
                .eq('auth_user_id', customerState.user.id).order('created_at', { ascending: false }),
            supabaseClient.from('payments').select('*')
                .eq('customer_id', customerState.customer.id).order('payment_date', { ascending: false })
        ]);
        if (orderResult.error) throw orderResult.error;
        if (paymentResult.error) throw paymentResult.error;
        customerState.payments = paymentResult.data || [];
        const paymentByOrder = Object.fromEntries(customerState.payments.map(payment => [payment.order_id, payment]));
        customerState.orders = (orderResult.data || []).map(row => mapCustomerOrder(row, paymentByOrder[row.id]));
        writeArray(ORDERS_KEY, customerState.orders);
        writeArray('favlor_customer_payments', customerState.payments);
        if (currentView === 'orders') renderOrders();
        updateOrderBadge();
        return true;
    }

    async function ensureActiveCart(product) {
        const context = await requireCustomerLogin();
        if (!context) return null;
        const fullProduct = productsCache.find(item => Number(item.id) === Number(product.id)) || product;
        const storeId = fullProduct.storeId;
        if (!storeId) throw new Error('Product store could not be resolved.');
        let cart = customerState.carts.find(item => item.store_id === storeId);
        if (cart) return cart;
        const existingResult = await supabaseClient.from('carts').select('id,store_id,status')
            .eq('user_id', context.user.id).eq('store_id', storeId).eq('status', 'active').maybeSingle();
        if (existingResult.error) throw existingResult.error;
        cart = existingResult.data;
        if (!cart) {
            const createResult = await supabaseClient.from('carts')
                .insert({ user_id: context.user.id, store_id: storeId, status: 'active' })
                .select('id,store_id,status').single();
            if (createResult.error) throw createResult.error;
            cart = createResult.data;
        }
        if (!customerState.carts.some(item => item.id === cart.id)) customerState.carts.push(cart);
        return cart;
    }

    async function setDatabaseCartQuantity(product, quantity, additive = false) {
        const cart = await ensureActiveCart(product);
        if (!cart) return false;
        const existingResult = await supabaseClient.from('cart_items')
            .select('id,quantity').eq('cart_id', cart.id).eq('product_id', Number(product.id)).maybeSingle();
        if (existingResult.error) throw existingResult.error;
        const nextQuantity = additive
            ? Number(existingResult.data?.quantity || 0) + Number(quantity)
            : Number(quantity);
        if (nextQuantity <= 0) {
            if (existingResult.data?.id) {
                const result = await supabaseClient.from('cart_items').delete().eq('id', existingResult.data.id);
                if (result.error) throw result.error;
            }
            return true;
        }
        const stock = Number(product.stock ?? product.stockQty ?? 999);
        if (stock >= 0 && nextQuantity > stock) throw new Error(`Only ${stock} item(s) are available.`);
        const payload = { cart_id: cart.id, product_id: Number(product.id), quantity: Math.min(999, nextQuantity) };
        const result = existingResult.data?.id
            ? await supabaseClient.from('cart_items').update({ quantity: payload.quantity }).eq('id', existingResult.data.id)
            : await supabaseClient.from('cart_items').insert(payload);
        if (result.error) throw result.error;
        return true;
    }

    function guestCart() { return readArray(GUEST_CART_KEY); }
    function saveGuestCart(items) {
        writeArray(GUEST_CART_KEY, items);
        writeArray(CART_KEY, items);
        updateCartUI(items);
    }

    window.getCartItems = function () { return customerState.user ? customerState.cart : guestCart(); };
    window.saveCartItems = function (items) {
        if (customerState.user) {
            customerState.cart = Array.isArray(items) ? items : [];
            writeArray(CART_KEY, customerState.cart);
            updateCartUI(customerState.cart);
        } else saveGuestCart(Array.isArray(items) ? items : []);
    };
    window.getOrders = () => customerState.user ? customerState.orders : [];
    window.saveOrders = orders => {
        customerState.orders = Array.isArray(orders) ? orders : [];
        writeArray(ORDERS_KEY, customerState.orders);
        if (currentView === 'orders') renderOrders();
        updateOrderBadge();
    };

    window.addItemToCart = async function (product) {
        if (productAvailability(product) === 'out_of_stock') {
            showToast('This product is out of stock.', 'warning'); return;
        }
        try {
            const { data: sessionData } = await supabaseClient.auth.getSession();
            if (!sessionData.session?.user) {
                const items = guestCart();
                const existing = items.find(item => Number(item.id) === Number(product.id));
                if (existing) existing.quantity += 1;
                else items.push({ id: Number(product.id), storeId: product.storeId, name: product.name,
                    price: Number(product.price || 0), image: product.image || PRODUCT_IMAGE_PLACEHOLDER,
                    stock: Number(product.stock ?? product.stockQty ?? 999), quantity: 1 });
                saveGuestCart(items);
                showToast(`"${product.name}" added to cart. Login before checkout.`, 'success');
                return;
            }
            if (!customerState.user) await loadCustomerContext();
            await setDatabaseCartQuantity(product, 1, true);
            await loadCustomerCart();
            showToast(`"${product.name}" added to Supabase cart.`, 'success');
        } catch (error) {
            console.error('Supabase cart add error:', error);
            showToast(error.message || 'Unable to add product to cart.', 'error');
        }
    };

    window.removeItemFromCart = async function (id) {
        const item = getCartItems().find(row => Number(row.id) === Number(id)); if (!item) return;
        if (!customerState.user) {
            const items = guestCart(); const index = items.findIndex(row => Number(row.id) === Number(id));
            if (items[index].quantity > 1) items[index].quantity -= 1; else items.splice(index, 1);
            saveGuestCart(items); renderCartModal(items); return;
        }
        try { await setDatabaseCartQuantity(item, item.quantity - 1); await loadCustomerCart(); }
        catch (error) { showToast(error.message || 'Unable to update cart.', 'error'); }
    };

    window.deleteItemFromCart = async function (id) {
        const item = getCartItems().find(row => Number(row.id) === Number(id)); if (!item) return;
        if (!customerState.user) {
            const items = guestCart().filter(row => Number(row.id) !== Number(id));
            saveGuestCart(items); renderCartModal(items); return;
        }
        try { await setDatabaseCartQuantity(item, 0); await loadCustomerCart(); }
        catch (error) { showToast(error.message || 'Unable to remove cart item.', 'error'); }
    };

    window.addOneMore = async function (id) {
        const product = productsCache.find(row => Number(row.id) === Number(id));
        if (product) await addItemToCart(product);
    };

    window.toggleWishlist = async function (id) {
        const context = await requireCustomerLogin(); if (!context) return;
        const exists = wishlist.includes(Number(id));
        const result = exists
            ? await supabaseClient.from('wishlist_items').delete().eq('user_id', context.user.id).eq('product_id', Number(id))
            : await supabaseClient.from('wishlist_items').insert({ user_id: context.user.id, product_id: Number(id) });
        if (result.error) return showToast(result.error.message || 'Wishlist update failed.', 'error');
        await loadCustomerLists();
        showToast(exists ? 'Removed from Wishlist' : 'Added to Wishlist', 'success');
    };

    window.toggleCompare = async function (id) {
        const context = await requireCustomerLogin(); if (!context) return;
        const exists = compareList.includes(Number(id));
        if (!exists && compareList.length >= 4) return showToast('Max 4 products to compare.', 'warning');
        const result = exists
            ? await supabaseClient.from('compare_items').delete().eq('user_id', context.user.id).eq('product_id', Number(id))
            : await supabaseClient.from('compare_items').insert({ user_id: context.user.id, product_id: Number(id) });
        if (result.error) return showToast(result.error.message || 'Compare update failed.', 'error');
        await loadCustomerLists();
        showToast(exists ? 'Removed from Compare' : 'Added to Compare', 'success');
    };

    window.placeOrder = async function (event) {
        event.preventDefault();
        const context = await requireCustomerLogin(); if (!context) return;
        const name = document.getElementById('custName').value.trim();
        const email = document.getElementById('custEmail').value.trim().toLowerCase();
        const phone = document.getElementById('custPhone').value.trim();
        const address = document.getElementById('custAddress').value.trim();
        const notes = document.getElementById('custNotes').value.trim();
        const paymentMethod = document.getElementById('custPaymentMethod').value;
        const items = customerState.cart;
        if (!name || !email || !phone || !address || !items.length) return showToast('Fill all required fields.', 'warning');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showToast('Invalid email.', 'warning');
        if (!/^[0-9]{10}$/.test(phone.replace(/[^0-9]/g, ''))) return showToast('Invalid phone.', 'warning');
        const button = document.getElementById('placeOrderBtn');
        button.disabled = true; button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Placing Order...';
        try {
            const { data, error } = await supabaseClient.rpc('place_customer_order', {
                p_customer_name: name,
                p_customer_email: email,
                p_customer_phone: phone,
                p_shipping_address: address,
                p_notes: notes || '',
                p_payment_method: paymentMethod,
                p_items: items.map(item => ({ product_id: Number(item.id), quantity: Number(item.quantity) }))
            });
            if (error) throw error;
            await Promise.all([
                loadCustomerCart(), loadCustomerOrders(),
                loadProductsFromSupabase({ showErrorToast: false })
            ]);
            closeCheckoutForm();
            document.getElementById('checkoutForm').reset();
            updateUserUI();
            switchView('orders'); renderOrders();
            const numbers = (data || []).map(row => row.order_number).filter(Boolean).join(', ');
            showToast(`Order placed successfully${numbers ? ': ' + numbers : ''}.`, 'success');
        } catch (error) {
            console.error('Supabase checkout error:', error);
            showToast(error.message || 'Unable to place order.', 'error');
        } finally {
            button.disabled = false; button.innerHTML = '<i class="fas fa-check-circle"></i> Place Order';
        }
    };

    async function loadProductReviews(productId) {
        const loginText = document.getElementById('customerReviewLogin');
        const form = document.getElementById('customerReviewForm');
        const list = document.getElementById('customerReviewList');
        loginText.textContent = customerState.user ? 'Your review will be visible after Admin approval.' : 'Login to submit a review.';
        form.style.display = customerState.user ? 'grid' : 'none';
        list.innerHTML = '<small>Loading reviews...</small>';
        const { data, error } = await supabaseClient.from('product_reviews')
            .select('id,customer_id,rating,title,review,status,created_at,customers(full_name)')
            .eq('product_id', Number(productId)).order('created_at', { ascending: false });
        if (error) { list.innerHTML = '<small>Reviews could not be loaded.</small>'; return; }
        list.innerHTML = (data || []).length ? (data || []).map(row => {
            const customer = Array.isArray(row.customers) ? row.customers[0] : row.customers;
            const status = row.status === 'Pending' ? ' · Pending approval' : '';
            return `<div class="customer-review-item"><strong>${'★'.repeat(Number(row.rating || 0))}${'☆'.repeat(5 - Number(row.rating || 0))} ${escapeHtml(row.title || '')}</strong><div>${escapeHtml(row.review || '')}</div><small>${escapeHtml(customer?.full_name || 'Customer')}${status}</small></div>`;
        }).join('') : '<small>No reviews yet.</small>';
    }

    window.submitCustomerReview = async function (event) {
        event.preventDefault();
        const context = await requireCustomerLogin(); if (!context || !currentProduct) return;
        const rating = Number(document.getElementById('customerReviewRating').value);
        const title = document.getElementById('customerReviewTitle').value.trim();
        const review = document.getElementById('customerReviewText').value.trim();
        if (!rating) return showToast('Select a rating.', 'warning');
        const existing = await supabaseClient.from('product_reviews').select('id,status')
            .eq('product_id', Number(currentProduct.id)).eq('customer_id', context.customer.id).maybeSingle();
        if (existing.error) return showToast(existing.error.message, 'error');
        if (existing.data?.status === 'Approved') return showToast('Approved review cannot be changed.', 'warning');
        const payload = { product_id: Number(currentProduct.id), customer_id: context.customer.id,
            rating, title: title || null, review: review || null, status: 'Pending' };
        const result = existing.data?.id
            ? await supabaseClient.from('product_reviews').update(payload).eq('id', existing.data.id)
            : await supabaseClient.from('product_reviews').insert(payload);
        if (result.error) return showToast(result.error.message || 'Review submission failed.', 'error');
        document.getElementById('customerReviewForm').reset();
        await loadProductReviews(currentProduct.id);
        showToast('Review submitted for Admin approval.', 'success');
    };

    const originalOpenProductModal = window.openModal;
    window.openModal = function (product) {
        originalOpenProductModal(product);
        loadProductReviews(product.id);
    };

    window.sendForgotOTP = async function () {
        const email = document.getElementById('forgotEmail').value.trim().toLowerCase();
        document.getElementById('forgotEmailError').textContent = '';
        document.getElementById('forgotError').textContent = '';
        if (!email || !email.includes('@')) {
            document.getElementById('forgotEmailError').textContent = 'Enter a valid email address.'; return;
        }
        const { error } = await supabaseClient.auth.resetPasswordForEmail(email, { redirectTo: window.location.href });
        if (error) { document.getElementById('forgotError').textContent = error.message; return; }
        closeForgotPasswordModal();
        showToast('Password reset link sent to your email.', 'success');
    };

    window.verifyForgotOTP = function () {
        document.getElementById('forgotOtpError').textContent = 'Use the secure reset link sent to your email.';
    };
    window.resendForgotOTP = window.sendForgotOTP;

    window.handleResetPassword = async function (event) {
        event.preventDefault();
        const password = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmNewPassword').value;
        document.getElementById('resetError').textContent = '';
        if (password.length < 6) return document.getElementById('newPasswordError').textContent = 'Minimum 6 characters required.';
        if (password !== confirmPassword) return document.getElementById('confirmNewPasswordError').textContent = 'Passwords do not match.';
        const { error } = await supabaseClient.auth.updateUser({ password });
        if (error) { document.getElementById('resetError').textContent = error.message; return; }
        document.getElementById('resetPasswordModal').classList.remove('active');
        document.getElementById('resetPasswordForm').reset();
        showToast('Password updated successfully.', 'success');
    };

    async function mergeGuestCart() {
        const items = guestCart();
        if (!customerState.user || !items.length) return;
        for (const item of items) {
            const product = productsCache.find(row => Number(row.id) === Number(item.id));
            if (product) await setDatabaseCartQuantity(product, Number(item.quantity || 1), true);
        }
        localStorage.removeItem(GUEST_CART_KEY);
    }

    async function loadAllCustomerData() {
        try {
            const context = await loadCustomerContext();
            if (!context) {
                customerState.cart = [];
                customerState.orders = [];
                wishlist = [];
                compareList = [];
                writeArray(ORDERS_KEY, []);
                writeArray('favlor_wishlist', []);
                writeArray('favlor_compare', []);
                const legacy = readArray(CART_KEY);
                if (!localStorage.getItem(GUEST_CART_KEY) && legacy.length) writeArray(GUEST_CART_KEY, legacy);
                updateCartUI(guestCart());
                updateOrderBadge();
                applyFilters();
                return false;
            }
            await mergeGuestCart();
            await Promise.all([loadCustomerCart(), loadCustomerLists(), loadCustomerOrders()]);
            subscribeCustomerRealtime();
            return true;
        } catch (error) {
            console.error('Customer full database load error:', error);
            showToast(error.message || 'Customer data could not be loaded.', 'error');
            return false;
        }
    }
    window.favlorLoadCustomerData = loadAllCustomerData;

    function scheduleCustomerReload() {
        clearTimeout(customerReloadTimer);
        customerReloadTimer = setTimeout(() => loadAllCustomerData(), 300);
    }

    function subscribeCustomerRealtime() {
        if (customerRealtimeChannel || !customerState.user) return;
        customerRealtimeChannel = supabaseClient.channel('customer-full-data-sync');
        ['carts', 'cart_items', 'wishlist_items', 'compare_items', 'orders', 'order_items', 'payments', 'product_reviews']
            .forEach(table => customerRealtimeChannel.on('postgres_changes', {
                event: '*', schema: 'public', table
            }, scheduleCustomerReload));
        customerRealtimeChannel.subscribe();
    }

    supabaseClient.auth.onAuthStateChange((event) => {
        if (event === 'PASSWORD_RECOVERY') {
            document.getElementById('forgotOtpModal').classList.remove('active');
            document.getElementById('resetPasswordModal').classList.add('active');
        }
        if (event === 'SIGNED_IN' || event === 'SIGNED_OUT' || event === 'USER_UPDATED') {
            window.setTimeout(async () => {
                if (event === 'SIGNED_OUT') {
                    if (customerRealtimeChannel) await supabaseClient.removeChannel(customerRealtimeChannel);
                    customerRealtimeChannel = null;
                    customerState.user = null; customerState.customer = null;
                    customerState.cart = []; customerState.orders = [];
                    writeArray(CART_KEY, []); writeArray(ORDERS_KEY, []);
                }
                await loadAllCustomerData();
            }, 0);
        }
    });

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadAllCustomerData);
    else loadAllCustomerData();
    window.addEventListener('focus', loadAllCustomerData);
})();
</script>
</body>
