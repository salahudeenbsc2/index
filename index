        function saveLegacyProducts(products) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(products));
            window.dispatchEvent(new StorageEvent('storage', { key: STORAGE_KEY, newValue: JSON.stringify(products),
                storageArea: localStorage }));
        }

        let productsCache = [];
        let productRealtimeChannel = null;
        let productReloadTimer = null;

        function getProducts() {
            return productsCache;
        }

        function productNumber(value, fallback = 0) {
            const number = Number(value);
            return Number.isFinite(number) ? number : fallback;
        }

        function normalizeProductImages(value) {
            if (Array.isArray(value)) return value.filter(item => typeof item === 'string' && item.trim());
            if (typeof value !== 'string' || !value.trim()) return [];

            const trimmed = value.trim();
            if (trimmed.startsWith('[')) {
                try {
                    const parsed = JSON.parse(trimmed);
                    if (Array.isArray(parsed)) return parsed.filter(item => typeof item === 'string' && item.trim());
                } catch (_) {}
            }
            return [trimmed];
        }

        function mapCustomerProduct(row) {
            const images = normalizeProductImages(row.images);
            const primaryImage = (typeof row.image === 'string' && row.image.trim()) ? row.image.trim() :
                (images[0] || PRODUCT_IMAGE_PLACEHOLDER);
            if (primaryImage !== PRODUCT_IMAGE_PLACEHOLDER && !images.includes(primaryImage)) images.unshift(primaryImage);

            const stockQty = productNumber(row.stockQty ?? row.stock, 0);
            return {
                ...row,
                id: productNumber(row.id),
                name: String(row.name || 'Unnamed Product'),
                brand: String(row.brand || ''),
                category: String(row.category || 'Other'),
                description: String(row.description || ''),
                price: productNumber(row.price),
                originalPrice: row.originalPrice == null ? 0 : productNumber(row.originalPrice),
                discount: productNumber(row.discount),
                savedAmount: productNumber(row.savedAmount),
                stock: productNumber(row.stock ?? row.stockQty),
                stockQty,
                reorderLevel: productNumber(row.reorderLevel),
                rating: productNumber(row.rating),
                reviewCount: productNumber(row.reviewCount),
                soldCount: productNumber(row.soldCount),
                images,
                image: primaryImage,
                availability: row.availability || (stockQty > 0 ? 'in_stock' : 'out_of_stock'),
                dateAdded: row.dateAdded || row.updatedDate || new Date(0).toISOString()
            };
        }

        function showProductsLoading() {
            const container = document.getElementById('productHorizontal');
            const resultCount = document.getElementById('resultCount');
            if (container) {
                container.innerHTML =
                    `<div class="empty-state-h"><i class="fas fa-spinner fa-spin"></i><h3>Loading products...</h3><p>Please wait a moment.</p></div>`;
            }
            if (resultCount) resultCount.textContent = 'Loading...';
        }

        function showProductsLoadError() {
            const container = document.getElementById('productHorizontal');
            const resultCount = document.getElementById('resultCount');
            if (container) {
                container.innerHTML =
                    `<div class="empty-state-h"><i class="fas fa-triangle-exclamation"></i><h3>Products could not be loaded</h3><p>Check the Supabase view and RLS policy, then refresh.</p></div>`;
            }
            if (resultCount) resultCount.textContent = 'Load failed';
        }

        async function loadProductsFromSupabase({ showLoading = false, showErrorToast = true } = {}) {
            if (showLoading) showProductsLoading();

            const { data, error } = await supabaseClient
                .from('customer_products')
                .select('*')
                .order('dateAdded', { ascending: false });

            if (error) {
                console.error('Supabase customer_products load failed:', error);
                if (productsCache.length) applyFilters();
                else showProductsLoadError();
                if (showErrorToast) showToast('Products load ஆகவில்லை. Supabase setup check பண்ணுங்க.', 'error');
                return false;
            }

            productsCache = (data || []).map(mapCustomerProduct);
            applyFilters();
            return true;
        }

        function scheduleProductsReload() {
            window.clearTimeout(productReloadTimer);
            productReloadTimer = window.setTimeout(() => {
                loadProductsFromSupabase({ showErrorToast: false });
            }, 250);
        }

        function subscribeToProductChanges() {
            if (productRealtimeChannel) return;
            productRealtimeChannel = supabaseClient
                .channel('customer-product-sync')
                .on('postgres_changes', { event: '*', schema: 'public', table: 'products' }, scheduleProductsReload)
                .on('postgres_changes', { event: '*', schema: 'public', table: 'stores' }, scheduleProductsReload)
                .subscribe(status => {
                    if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
                        console.error('Supabase product Realtime status:', status);
                    }
                });
        }

        function productAvailability(p) {
            if (p.availability) return p.availability;
            if (p.inStock !== undefined) return p.inStock ? 'in_stock' : 'out_of_stock';
            return 'in_stock';
        }

