<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Favlor Store</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        /* ----- RESET & BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ----- HEADER (Customer Only) ----- */
        .customer-header {
            background: linear-gradient(135deg, #e8511b, #d84315);
            color: #fff;
            padding: 14px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            box-shadow: 0 4px 12px rgba(232, 81, 27, 0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .customer-header .brand {
            font-size: 22px;
            font-weight: 700;
            cursor: pointer;
            user-select: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .brand:hover {
            opacity: 0.9;
        }
        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .header-category-menu {
            position: relative;
        }
        .header-category-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.35);
            color: #fff;
            padding: 9px 16px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.25s;
        }
        .header-category-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.03);
        }
        .header-category-btn.active {
            background: #fff;
            color: #e8511b;
        }
        .header-search-btn {
            width: 42px;
            height: 42px;
            border: 1px solid rgba(255, 255, 255, 0.35);
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.25s;
        }
        .header-search-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.05);
        }
        .header-search-btn.active {
            background: #fff;
            color: #e8511b;
        }
        .category-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            width: 290px;
            max-width: calc(100vw - 32px);
            padding: 12px;
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 18px;
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.18);
            z-index: 400;
        }
        .category-dropdown.open {
            display: block;
            animation: fadeIn 0.2s ease;
        }
        .category-dropdown-title {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 8px 10px;
            margin-bottom: 6px;
            border-bottom: 1px solid #f3f3f3;
            color: #333;
            font-size: 15px;
            font-weight: 700;
        }
        .category-dropdown-title i {
            color: #e8511b;
        }

        .header-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #fff;
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .header-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.03);
        }
        .header-btn.active {
            background: rgba(255, 255, 255, 0.35);
            border-color: #fff;
        }
        .badge-dot {
            width: 8px;
            height: 8px;
            background: #ffca28;
            border-radius: 50%;
            display: inline-block;
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.8); }
        }

        .cart-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #fff;
            padding: 8px 16px 8px 14px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
        }
        .cart-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.03);
        }
        .cart-count {
            background: #ffca28;
            color: #1a237e;
            font-size: 12px;
            font-weight: 700;
            padding: 2px 10px;
            border-radius: 30px;
            min-width: 22px;
            text-align: center;
            line-height: 1.6;
            transition: 0.3s;
        }
        .cart-count.bump {
            animation: bump 0.3s ease;
        }
        @keyframes bump {
            0% { transform: scale(1); }
            50% { transform: scale(1.4); }
            100% { transform: scale(1); }
        }

        .live-indicator {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #e8f5e9;
            color: #2e7d32;
            padding: 4px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
        }
        .live-indicator .dot {
            width: 8px;
            height: 8px;
            background: #2e7d32;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        /* Login / Register / Profile */
        .header-login-btn {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: #fff;
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .header-login-btn:hover {
            background: rgba(255, 255, 255, 0.30);
            transform: scale(1.05);
        }
        .header-register-btn {
            background: #fff;
            color: #e8511b;
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
        .header-register-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

        .user-profile {
            position: relative;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 4px 14px 4px 8px;
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: 0.3s;
        }
        .user-profile:hover {
            background: rgba(255, 255, 255, 0.25);
        }
        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #ffca28;
            color: #1a237e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }
        .user-name {
            font-size: 13px;
            font-weight: 500;
            max-width: 120px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .user-dropdown {
            display: none;
            position: absolute;
            top: 44px;
            right: 0;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
            min-width: 200px;
            padding: 8px 0;
            z-index: 200;
            border: 1px solid #f0f0f0;
        }
        .user-dropdown.open {
            display: block;
        }
        .dropdown-item {
            padding: 10px 20px;
            color: #333;
            font-size: 14px;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 10px;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }
        .dropdown-item:hover {
            background: #f5f5f5;
        }
        .dropdown-item.active {
            background: #fff3ed;
            color: #e8511b;
            font-weight: 700;
        }
        .dropdown-item .cart-count,
        .dropdown-item .badge-dot {
            margin-left: auto;
        }
        .dropdown-item.logout {
            color: #c62828;
            border-top: 1px solid #f0f0f0;
            margin-top: 4px;
            padding-top: 10px;
        }
        .dropdown-item.logout:hover {
            background: #ffebee;
        }

        /* ----- MAIN CONTAINER ----- */
        .container {
            max-width: 1400px;
            margin: 30px 20px;
            padding: 0;
            flex: 1;
            display: flex;
            gap: 28px;
            align-items: flex-start;
        }
        .sidebar {
            width: 250px;
            min-width: 200px;
            background: #fff;
            border-radius: 18px;
            padding: 24px 20px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
            position: sticky;
            top: 100px;
            max-height: calc(100vh - 160px);
            overflow-y: auto;
            border: 1px solid #f0f0f0;
        }
        .sidebar-title {
            font-size: 18px;
            font-weight: 700;
            color: #bf360c;
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 14px;
            border-bottom: 2px solid #fbe9e7;
            margin-bottom: 16px;
        }
        .sidebar-title i {
            color: #e8511b;
            font-size: 20px;
        }
        .category-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .cat-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s;
            font-size: 14px;
            color: #444;
            font-weight: 500;
            border: 1px solid transparent;
        }
        .cat-item:hover {
            background: #fbe9e7;
            color: #e8511b;
            border-color: #fbe9e7;
        }
        .cat-item.active {
            background: #e8511b;
            color: #fff;
            border-color: #e8511b;
            box-shadow: 0 4px 12px rgba(232, 81, 27, 0.25);
        }
        .cat-icon {
            width: 28px;
            text-align: center;
            font-size: 16px;
        }
        .cat-count {
            margin-left: auto;
            background: #f0f0f0;
            padding: 1px 10px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 600;
            color: #888;
        }
        .cat-item.active .cat-count {
            background: rgba(255, 255, 255, 0.25);
            color: #fff;
        }

        .filter-section {
            margin-top: 24px;
            border-top: 1px solid #f0f0f0;
            padding-top: 16px;
        }
        .filter-section .sidebar-title {
            font-size: 16px;
            padding-bottom: 10px;
            border-bottom: 2px solid #fbe9e7;
            margin-bottom: 12px;
        }
        .price-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s;
            font-size: 14px;
            color: #444;
            font-weight: 500;
            border: 1px solid transparent;
        }
        .price-item:hover {
            background: #fbe9e7;
            color: #e8511b;
            border-color: #fbe9e7;
        }
        .price-item.active {
            background: #e8511b;
            color: #fff;
            border-color: #e8511b;
            box-shadow: 0 4px 12px rgba(232, 81, 27, 0.25);
        }
        .price-item .cat-icon {
            width: 28px;
            text-align: center;
            font-size: 16px;
        }

        .filter-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.2s;
        }
        .filter-option:hover {
            background: #fbe9e7;
        }
        .filter-option input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #e8511b;
            cursor: pointer;
            flex-shrink: 0;
        }
        .filter-option label {
            font-size: 14px;
            font-weight: 500;
            color: #444;
            cursor: pointer;
            user-select: none;
        }
        .filter-option .avail-badge {
            font-size: 10px;
            padding: 2px 10px;
            border-radius: 30px;
            font-weight: 600;
            margin-left: auto;
        }
        .avail-badge.in-stock {
            background: #e8f5e9;
            color: #2e7d32;
        }
        .avail-badge.out-of-stock {
            background: #ffebee;
            color: #c62828;
        }
        .avail-badge.pre-order {
            background: #fff3e0;
            color: #e65100;
        }

        .sort-select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            color: #444;
            background: #fafafa;
            cursor: pointer;
            outline: none;
        }
        .sort-select:focus {
            border-color: #e8511b;
            box-shadow: 0 0 0 4px rgba(232, 81, 27, 0.08);
            background: #fff;
        }

        .content-area {
            flex: 1;
            min-width: 0;
        }
        .search-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            background: #fff;
            border-radius: 50px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
            border: 2px solid #f0f0f0;
            transition: 0.3s;
            margin-bottom: 24px;
        }
        .customer-header .header-search-panel {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 30px;
            width: 620px;
            max-width: calc(100vw - 32px);
            margin: 0;
            border-color: #f0f0f0;
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.2);
            z-index: 500;
        }
        .customer-header .header-search-panel.open {
            display: flex;
            animation: fadeIn 0.2s ease;
        }
        .search-wrapper:focus-within {
            border-color: #e8511b;
            box-shadow: 0 4px 20px rgba(232, 81, 27, 0.12);
        }
        .search-wrapper .search-icon {
            position: absolute;
            left: 18px;
            color: #999;
            font-size: 18px;
            pointer-events: none;
        }
        .search-wrapper input {
            width: 100%;
            padding: 14px 152px 14px 50px;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            background: transparent;
            color: #333;
            outline: none;
        }
        .search-wrapper input::placeholder {
            color: #aaa;
            font-weight: 400;
        }
        .clear-search-btn {
            position: absolute;
            right: 98px;
            background: none;
            border: none;
            color: #ccc;
            font-size: 20px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 50%;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .clear-search-btn:hover {
            color: #c62828;
            background: #ffebee;
        }
        .clear-search-btn.hidden {
            display: none;
        }
        .price-filter-toggle,
        .sort-toggle {
            position: absolute;
            right: 8px;
            width: 38px;
            height: 38px;
            border: none;
            border-radius: 50%;
            background: #fff3ed;
            color: #e8511b;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.25s;
        }
        .price-filter-toggle {
            right: 52px;
        }
        .sort-toggle {
            right: 8px;
        }
        .price-filter-toggle:hover,
        .sort-toggle:hover {
            background: #ffe4d8;
            transform: scale(1.05);
        }
        .price-filter-toggle.active,
        .price-filter-toggle.filtered,
        .sort-toggle.active,
        .sort-toggle.sorted {
            background: #e8511b;
            color: #fff;
            box-shadow: 0 4px 12px rgba(232, 81, 27, 0.28);
        }
        .price-filter-popup,
        .sort-popup {
            display: none;
            position: absolute;
            top: calc(100% + 12px);
            right: 0;
            width: 270px;
            max-width: calc(100vw - 40px);
            padding: 12px;
            background: #fff;
            border: 1px solid #f0f0f0;
            border-radius: 18px;
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.16);
            z-index: 350;
        }
        .price-filter-popup.open,
        .sort-popup.open {
            display: block;
            animation: fadeIn 0.2s ease;
        }
        .price-filter-popup-title,
        .sort-popup-title {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 8px 10px;
            margin-bottom: 6px;
            border-bottom: 1px solid #f3f3f3;
            color: #333;
            font-size: 15px;
            font-weight: 700;
        }
        .price-filter-popup-title i,
        .sort-popup-title i {
            color: #e8511b;
        }

        .welcome-heading {
            font-size: 22px;
            color: #bf360c;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f0f0f0;
            flex-wrap: wrap;
        }
        .welcome-heading span {
            font-size: 14px;
            font-weight: 400;
            color: #888;
        }

        /* ----- Products View ----- */
        .view-products {
            display: block;
        }
        .view-products.hidden {
            display: none;
        }
        .horizontal-scroll-wrapper {
            overflow-x: auto;
            overflow-y: hidden;
            padding: 8px 4px 16px 4px;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
        }
        .horizontal-scroll-wrapper::-webkit-scrollbar {
            height: 8px;
        }
        .horizontal-scroll-wrapper::-webkit-scrollbar-track {
            background: #f0f0f0;
            border-radius: 10px;
        }
        .horizontal-scroll-wrapper::-webkit-scrollbar-thumb {
            background: #e8511b;
            border-radius: 10px;
        }
        .horizontal-scroll-wrapper::-webkit-scrollbar-thumb:hover {
            background: #bf360c;
        }
        .product-horizontal {
            display: flex;
            gap: 20px;
            min-width: max-content;
            padding: 4px 2px;
        }
        .product-card-h {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
            transition: 0.3s ease;
            border: 1px solid #f0f0f0;
            width: 260px;
            min-width: 240px;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            position: relative;
        }
        .product-card-h:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 36px rgba(232, 81, 27, 0.15);
            border-color: #fbe9e7;
        }
        .image-wrapper {
            position: relative;
            overflow: hidden;
            background: #f5f5f5;
            height: 200px;
            flex-shrink: 0;
        }
        .card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.3s;
            pointer-events: none;
        }
        .product-card-h:hover .card-img {
            transform: scale(1.03);
        }

        /* Top-right buttons (wishlist, compare) */
        .card-actions-top {
            position: absolute;
            top: 10px;
            right: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            z-index: 5;
        }
        .card-action-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.85);
            border: none;
            color: #888;
            font-size: 14px;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            backdrop-filter: blur(4px);
        }
        .card-action-btn:hover {
            background: #fff;
            transform: scale(1.1);
        }
        .card-action-btn.wishlist-active {
            color: #e8511b;
        }
        .card-action-btn.compare-active {
            color: #1a237e;
        }
        /* Discount badge */
        .discount-badge {
            position: absolute;
            bottom: 10px;
            left: 10px;
            background: #c62828;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            padding: 3px 12px;
            border-radius: 30px;
            z-index: 5;
        }
        .card-body {
            padding: 14px 16px 16px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .product-brand {
            font-size: 12px;
            font-weight: 600;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .product-name {
            font-size: 15px;
            font-weight: 700;
            color: #1a237e;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .product-category {
            font-size: 11px;
            font-weight: 600;
            color: #e8511b;
            background: #fbe9e7;
            padding: 2px 12px;
            border-radius: 30px;
            display: inline-block;
            align-self: flex-start;
        }
        .product-rating {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: #888;
            margin-top: 2px;
        }
        .product-rating .stars {
            color: #ffca28;
            letter-spacing: 1px;
        }
        .product-rating .review-count {
            font-size: 12px;
            color: #999;
        }
        .product-price-row {
            display: flex;
            align-items: center;
            gap: 10px;
