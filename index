                <div class="detail-total"><span>Total</span><span class="total-amount">${getSettings().currencySymbol || '₹'}${Number(order.total).toFixed(2)}</span></div>
            `;
            document.getElementById('orderDetailModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeOrderDetail() {
            document.getElementById('orderDetailModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function updateOrderBadge() {
            const orders = getOrders();
            const badge = document.getElementById('orderBadge');
            badge.style.display = orders.length > 0 ? 'inline-block' : 'none';
        }

        // ----- WISHLIST & COMPARE -----
        function toggleWishlist(id) {
            const idx = wishlist.indexOf(id);
            if (idx > -1) wishlist.splice(idx, 1);
            else wishlist.push(id);
            localStorage.setItem('favlor_wishlist', JSON.stringify(wishlist));
            applyFilters();
            showToast(idx > -1 ? 'Removed from Wishlist' : 'Added to Wishlist ❤️', 'success');
        }

        function toggleCompare(id) {
            const idx = compareList.indexOf(id);
            if (idx > -1) compareList.splice(idx, 1);
            else {
                if (compareList.length >= 4) { showToast('Max 4 products to compare.', 'warning'); return; }
                compareList.push(id);
            }
            localStorage.setItem('favlor_compare', JSON.stringify(compareList));
            applyFilters();
            showToast(idx > -1 ? 'Removed from Compare' : 'Added to Compare', 'success');
        }

        // ----- PRODUCT MODAL -----
        function normalizeProductImage(value) {
            if (typeof value === 'string') return value.trim();
            if (!value || typeof value !== 'object') return '';
            return value.url || value.src || value.dataUrl || value.data || value.preview || value.image || '';
        }

        function getProductImages(product) {
            if (!product || typeof product !== 'object') return [];
            const candidates = [];
            ['images', 'productImages', 'galleryImages'].forEach(key => {
                if (Array.isArray(product[key])) candidates.push(...product[key]);
            });
            ['image', 'image1', 'image2', 'image3', 'image4', 'image5'].forEach(key => {
                if (product[key]) candidates.push(product[key]);
            });
            return [...new Set(candidates.map(normalizeProductImage).filter(Boolean))].slice(0, 5);
        }

        function renderModalGallery() {
            const imageCount = currentModalImages.length;
            const mainImage = document.getElementById('modalImage');
            const activeImage = imageCount ? currentModalImages[currentModalImageIndex] : PRODUCT_IMAGE_PLACEHOLDER;
            mainImage.onerror = function() {
                this.onerror = null;
                this.src = PRODUCT_IMAGE_PLACEHOLDER;
            };
            mainImage.src = activeImage;
            document.getElementById('modalImageCount').textContent = imageCount ?
                `${currentModalImageIndex + 1} / ${imageCount}` : 'No Image';
            document.getElementById('modalPrevImage').disabled = imageCount <= 1;
            document.getElementById('modalNextImage').disabled = imageCount <= 1;

            const thumbnails = document.getElementById('modalThumbnails');
            thumbnails.innerHTML = '';
            for (let index = 0; index < 5; index++) {
                const button = document.createElement('button');
                button.type = 'button';
                if (index < imageCount) {
                    button.className = `modal-thumb ${index === currentModalImageIndex ? 'active' : ''}`;
                    button.setAttribute('aria-label', `View product image ${index + 1}`);
                    button.onclick = () => selectModalImage(index);
                    const image = document.createElement('img');
                    image.src = currentModalImages[index];
                    image.alt = `${currentProduct ? currentProduct.name : 'Product'} image ${index + 1}`;
                    image.onerror = function() {
                        this.onerror = null;
                        this.src = PRODUCT_IMAGE_PLACEHOLDER;
                    };
                    button.appendChild(image);
                } else {
                    button.className = 'modal-thumb empty';
                    button.disabled = true;
                    button.innerHTML = `<i class="far fa-image"></i><span>Image ${index + 1}</span>`;
                }
                thumbnails.appendChild(button);
            }
        }

        function selectModalImage(index) {
            if (index < 0 || index >= currentModalImages.length) return;
            currentModalImageIndex = index;
            renderModalGallery();
        }

        function changeModalImage(direction) {
            if (currentModalImages.length <= 1) return;
            currentModalImageIndex = (currentModalImageIndex + direction + currentModalImages.length) %
                currentModalImages.length;
            renderModalGallery();
        }

        function openModal(product) {
            currentProduct = product;
            currentModalImages = getProductImages(product);
            currentModalImageIndex = 0;
            renderModalGallery();
            document.getElementById('modalCategory').textContent = product.category || 'Other';
            document.getElementById('modalName').textContent = product.name;
            document.getElementById('modalPrice').innerHTML =
                `${getSettings().currencySymbol || '₹'}${Number(product.price).toFixed(2)} <span>INR</span>`;
            document.getElementById('modalDesc').textContent = product.description || 'No description.';
            const btn = document.getElementById('modalAddBtn');
            if (productAvailability(product) === 'out_of_stock') {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-times-circle"></i> Out of Stock';
                btn.style.background = '#ccc';
                btn.style.cursor = 'not-allowed';
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-cart-plus"></i> Add to Cart';
                btn.style.background = '#e8511b';
                btn.style.cursor = 'pointer';
            }
            document.getElementById('productModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('productModal').classList.remove('active');
            document.body.style.overflow = '';
            currentProduct = null;
            currentModalImages = [];
            currentModalImageIndex = 0;
        }

        function addToCart() {
            if (currentProduct) { addItemToCart(currentProduct);
                closeModal(); }
        }

        document.getElementById('productModal').addEventListener('click', function(e) { if (e.target === this) closeModal(); });

        // ----- AUTH -----
        function getCurrentUser() {
            try { const raw = localStorage.getItem('favlor_auth'); if (raw) return JSON.parse(raw); } catch (e) {}
            return null;
        }

        function isLoggedIn() { return getCurrentUser() !== null; }

        function openAuthModal(tab) {
            document.getElementById('authModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            document.querySelectorAll('#authModal .field-error').forEach(el => el.textContent = '');
            document.getElementById('loginErrorModal').textContent = '';
            document.getElementById('loginSuccessModal').textContent = '';
            document.getElementById('registerErrorModal').textContent = '';
            document.getElementById('registerSuccessModal').textContent = '';
            switchAuthTabModal(tab || 'login');
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function switchAuthTabModal(tab) {
            const selectedTab = tab === 'register' ? 'register' : 'login';
            const isLogin = selectedTab === 'login';
            document.getElementById('loginFormModal').classList.toggle('active', isLogin);
            document.getElementById('registerFormModal').classList.toggle('active', !isLogin);
            document.getElementById('authSubtitle').textContent = isLogin
                ? 'Sign in to track orders & shop faster'
                : 'Create your account to start shopping';

            window.setTimeout(() => {
                const firstInput = document.querySelector(`#${isLogin ? 'loginFormModal' : 'registerFormModal'} input`);
                if (firstInput) firstInput.focus();
            }, 0);
        }

        function togglePasswordModal(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (input.type === 'password') { input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash'); } else { input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye'); }
        }

        function handleLoginModal(e) {
            e.preventDefault();
            document.getElementById('loginErrorModal').textContent = '';
            const email = document.getElementById('loginEmailModal').value.trim();
            const password = document.getElementById('loginPasswordModal').value;
            const users = getUsers();
            const user = users.find(u => u.email === email && u.password === password);
            if (!user) { document.getElementById('loginErrorModal').textContent = '❌ Invalid email or password.'; return; }
            localStorage.setItem('favlor_auth', JSON.stringify({ name: user.name, email: user.email, phone: user
                    .phone || '', role: user.role }));
            closeAuthModal();
            updateUserUI();
            showToast(`👋 Welcome back, ${user.name}!`, 'success');
            document.getElementById('loginFormModal').reset();
        }

        function handleRegisterModal(e) {
            e.preventDefault();
            document.querySelectorAll('#registerFormModal .field-error').forEach(el => el.textContent = '');
            document.getElementById('registerErrorModal').textContent = '';
            document.getElementById('registerSuccessModal').textContent = '';

            const name = document.getElementById('regNameModal').value.trim();
            const email = document.getElementById('regEmailModal').value.trim();
            const phone = document.getElementById('regPhoneModal').value.trim();
            const password = document.getElementById('regPasswordModal').value;
            const confirm = document.getElementById('regConfirmPasswordModal').value;
            const terms = document.getElementById('regTermsModal').checked;

            if (!name || !email || !phone || !password || !confirm || !terms) {
                showToast('Please fill in all fields.', 'error');
                return;
            }
            if (password.length < 6) { document.getElementById('regPasswordError').innerHTML =
                    '<i class="fas fa-exclamation-circle"></i> Min 6 characters.';
                return; }
            if (password !== confirm) { document.getElementById('regConfirmError').innerHTML =
                    '<i class="fas fa-exclamation-circle"></i> Passwords do not match.';
                return; }
            const users = getUsers();
            if (users.find(u => u.email === email)) { document.getElementById('regEmailError').innerHTML =
                    '<i class="fas fa-exclamation-circle"></i> Email already exists.';
                return; }

            const newUser = { id: users.length + 1, name, email, phone, password, role: 'customer' };
            users.push(newUser);
            saveUsers(users);
            localStorage.setItem('favlor_auth', JSON.stringify({ name, email, phone, role: 'customer' }));
            closeAuthModal();
            updateUserUI();
            showToast(`✅ Welcome ${name}! Your account has been created.`, 'success');
            document.getElementById('registerFormModal').reset();
        }

        function handleLogout() {
            if (!confirm('Are you sure you want to logout?')) return;
            localStorage.removeItem('favlor_auth');
            updateUserUI();
            document.getElementById('userDropdown').classList.remove('open');
            showToast('Logged out successfully.', 'warning');
        }

        function updateUserUI() {
            const user = getCurrentUser();
            const avatar = document.getElementById('userAvatar');
            const nameDisplay = document.getElementById('userNameDisplay');
            const dropdownName = document.getElementById('dropdownUserName');
            const dropdownEmail = document.getElementById('dropdownUserEmail');
            if (user) {
                document.getElementById('headerLoginBtn').style.display = 'none';
                document.getElementById('headerRegisterBtn').style.display = 'none';
                document.getElementById('userProfile').style.display = 'flex';
                avatar.textContent = user.name.charAt(0).toUpperCase();
                nameDisplay.textContent = user.name;
                dropdownName.textContent = user.name;
                dropdownEmail.textContent = user.email;
                document.getElementById('custName').value = user.name;
                document.getElementById('custEmail').value = user.email;
                if (user.phone) document.getElementById('custPhone').value = user.phone;
            } else {
                document.getElementById('headerLoginBtn').style.display = 'inline-block';
                document.getElementById('headerRegisterBtn').style.display = 'inline-block';
                document.getElementById('userProfile').style.display = 'none';
                avatar.textContent = 'U';
                nameDisplay.textContent = 'Guest';
                dropdownName.textContent = 'Guest';
                dropdownEmail.textContent = '—';
                document.getElementById('custName').value = '';
                document.getElementById('custEmail').value = '';
            }
        }

        function toggleDropdown(e) {
            e.stopPropagation();
            closeCategoryMenu();
            closeHeaderSearch();
            document.getElementById('userDropdown').classList.toggle('open');
        }
        document.addEventListener('click', function(e) {
            const profile = document.getElementById('userProfile');
            if (profile && !profile.contains(e.target)) document.getElementById('userDropdown').classList.remove('open');
        });

        // ----- FORGOT PASSWORD (demo) -----
        function openForgotPasswordModal() { document.getElementById('forgotPasswordModal').classList.add('active'); }

        function closeForgotPasswordModal() { document.getElementById('forgotPasswordModal').classList.remove('active'); }

        function sendForgotOTP() {
            const email = document.getElementById('forgotEmail').value.trim();
            document.getElementById('forgotEmailError').textContent = '';
            document.getElementById('forgotError').textContent = '';
            if (!email) { document.getElementById('forgotEmailError').innerHTML =
                    '<i class="fas fa-exclamation-circle"></i> Enter email.'; return; }
            if (!email.includes('@')) { document.getElementById('forgotEmailError').innerHTML =
                    '<i class="fas fa-exclamation-circle"></i> Invalid email.'; return; }
            const users = getUsers();
            if (!users.find(u => u.email === email)) { document.getElementById('forgotError').textContent =
                    'Email not found.'; return; }
            showToast('📧 OTP sent to your email (demo: 123456)', 'success');
            closeForgotPasswordModal();
            document.getElementById('forgotOtpModal').classList.add('active');
        }

        function verifyForgotOTP() {
            const otp = document.getElementById('forgotOtpInput').value.trim();
            if (otp === '123456') {
                document.getElementById('forgotOtpModal').classList.remove('active');
                document.getElementById('resetPasswordModal').classList.add('active');
                showToast('OTP verified!', 'success');
            } else {
                document.getElementById('forgotOtpError').textContent = 'Invalid OTP.';
            }
        }

        function resendForgotOTP() {
            showToast('📧 New OTP sent (123456)', 'success');
            document.getElementById('forgotOtpError').textContent = '';
        }

        function handleResetPassword(e) {
            e.preventDefault();
            const newPass = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmNewPassword').value;
            document.getElementById('newPasswordError').textContent = '';
            document.getElementById('confirmNewPasswordError').textContent = '';
            if (!newPass || newPass.length < 6) { document.getElementById('newPasswordError').innerHTML =
                    'Min 6 characters.'; return; }
            if (newPass !== confirm) { document.getElementById('confirmNewPasswordError').innerHTML =
                    'Passwords do not match.'; return; }
            // Update password in users (demo - just show success)
            showToast('✅ Password updated! Please login.', 'success');
            document.getElementById('resetPasswordModal').classList.remove('active');
        }

        // =============================================================
        // 3. INIT
        // =============================================================
        // Load customer data. Products come from Supabase; customer-only data stays in this browser.
        getUsers();
        getOrders();
        getSettings();

        // Update UI based on login status
        updateUserUI();
        updateCartUI(getCartItems());
        updateOrderBadge();
        switchView('products');
        showProductsLoading();
        subscribeToProductChanges();
        loadProductsFromSupabase();

        // Welcome toast
        setTimeout(() => {
            if (!isLoggedIn()) {
                showToast('👋 Welcome! Login or register to place orders.', 'warning');
            }
        }, 600);

        // Storage sync (for multi-tab support)
        window.addEventListener('storage', (e) => {
            if (e.key === ORDERS_KEY) {
                if (currentView === 'orders') renderOrders();
                updateOrderBadge();
                showToast('📦 Orders updated', 'warning');
            }
            if (e.key === CART_KEY) {
                try { const items = JSON.parse(e.newValue) || [];
                    updateCartUI(items); } catch (_) {}
            }
            if (e.key === SETTINGS_KEY) {
                // Currency might change, refresh UI
                applyFilters();
                showToast('🔄 Settings updated', 'warning');
            }
        });

        // Event listeners for modal close on backdrop
        document.getElementById('productModal').addEventListener('click', function(e) { if (e.target === this) closeModal(); });
        document.getElementById('cartModal').addEventListener('click', function(e) { if (e.target === this) closeCartModal(); });
        document.getElementById('checkoutModal').addEventListener('click', function(e) { if (e.target === this)
                closeCheckoutForm(); });
        document.getElementById('orderDetailModal').addEventListener('click', function(e) { if (e.target === this)
                closeOrderDetail(); });
        document.getElementById('authModal').addEventListener('click', function(e) { if (e.target === this) closeAuthModal(); });
        document.getElementById('forgotPasswordModal').addEventListener('click', function(e) { if (e.target === this)
                closeForgotPasswordModal(); });
        document.getElementById('forgotOtpModal').addEventListener('click', function(e) { if (e.target === this) {
                // Don't close on backdrop to prevent accidental loss
                showToast('Please verify or cancel.', 'warning');
            } });
        document.getElementById('resetPasswordModal').addEventListener('click', function(e) { if (e.target === this) {
                showToast('Complete the reset or cancel.', 'warning');
            } });

        console.log('✅ Customer Portal loaded successfully.');
        console.log('💡 Admin and Super Admin portals are NOT included in this file.');
        console.log('📦 Products load from Supabase and refresh through Realtime.');
    </script>

<script>
// ===== SUPABASE CUSTOMER AUTH + REGISTRATION SYNC =====
(function () {
    function setCustomerAuthState(user) {
        if (user) {
            localStorage.setItem('favlor_auth', JSON.stringify({
                id: user.id,
                name: user.name || 'Customer',
                email: user.email || '',
                phone: user.phone || '',
                role: 'customer'
            }));
        } else {
            localStorage.removeItem('favlor_auth');
        }
        updateUserUI();
    }

    async function getCustomerProfile(authUser) {
        const { data, error } = await supabaseClient
            .from('customers')
            .select('id, full_name, email, phone, status')
            .eq('auth_user_id', authUser.id)
            .maybeSingle();
        if (error) throw error;
        if (!data) throw new Error('Customer profile not found. Please contact support.');
        if (data.status !== 'Active') throw new Error(`Customer account is ${data.status}.`);
        return {
            id: authUser.id,
            name: data?.full_name || authUser.user_metadata?.name || authUser.email?.split('@')[0] || 'Customer',
            email: data?.email || authUser.email || '',
            phone: data?.phone || authUser.user_metadata?.phone || '',
            role: 'customer'
        };
    }

    window.handleRegisterModal = async function (event) {
        event.preventDefault();
        document.querySelectorAll('#registerFormModal .field-error').forEach(element => element.textContent = '');
        document.getElementById('registerErrorModal').textContent = '';
        document.getElementById('registerSuccessModal').textContent = '';

        const name = document.getElementById('regNameModal').value.trim();
        const email = document.getElementById('regEmailModal').value.trim().toLowerCase();
        const phone = document.getElementById('regPhoneModal').value.trim();
        const password = document.getElementById('regPasswordModal').value;
        const confirmPassword = document.getElementById('regConfirmPasswordModal').value;
        const termsAccepted = document.getElementById('regTermsModal').checked;
        const button = document.getElementById('registerBtn');

        if (!name || !email || !phone || !password || !confirmPassword || !termsAccepted) {
            showToast('Please fill in all fields.', 'error');
            return;
        }
        if (password.length < 6) {
            document.getElementById('regPasswordError').innerHTML =
                '<i class="fas fa-exclamation-circle"></i> Min 6 characters.';
            return;
        }
        if (password !== confirmPassword) {
            document.getElementById('regConfirmError').innerHTML =
                '<i class="fas fa-exclamation-circle"></i> Passwords do not match.';
            return;
        }

        button.disabled = true;
        button.textContent = 'Creating Account...';
        try {
            const { data, error } = await supabaseClient.auth.signUp({
                email,
                password,
                options: { data: { name, full_name: name, phone } }
            });
            if (error) throw error;
            if (data.user && Array.isArray(data.user.identities) && data.user.identities.length === 0) {
                throw new Error('This email is already registered. Please login.');
            }

            document.getElementById('registerFormModal').reset();
            if (data.session && data.user) {
                setCustomerAuthState({ id: data.user.id, name, email, phone });
                closeAuthModal();
                showToast(`Welcome ${name}! Your account has been created.`, 'success');
            } else {
                document.getElementById('registerSuccessModal').textContent =
                    'Account created. Please verify your email, then login.';
                showToast('Account created. Check your email for verification.', 'success');
            }
        } catch (error) {
            console.error('Supabase customer registration error:', error);
            document.getElementById('registerErrorModal').textContent = error.message || 'Unable to create account.';
        } finally {
            button.disabled = false;
            button.textContent = 'Create Account';
        }
    };

    window.handleLoginModal = async function (event) {
        event.preventDefault();
        const errorBox = document.getElementById('loginErrorModal');
        const form = document.getElementById('loginFormModal');
        const button = form.querySelector('.auth-btn');
        const email = document.getElementById('loginEmailModal').value.trim().toLowerCase();
        const password = document.getElementById('loginPasswordModal').value;
        errorBox.textContent = '';

        button.disabled = true;
        button.textContent = 'Logging in...';
        try {
            const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
            if (error) throw error;
            const profile = await getCustomerProfile(data.user);
            setCustomerAuthState(profile);
            closeAuthModal();
            form.reset();
            showToast(`Welcome back, ${profile.name}!`, 'success');
        } catch (error) {
            console.error('Supabase customer login error:', error);
            await supabaseClient.auth.signOut().catch(() => {});
            errorBox.textContent = error.message || 'Invalid email or password.';
        } finally {
            button.disabled = false;
            button.textContent = 'Login';
        }
    };

    window.handleLogout = async function () {
        if (!confirm('Are you sure you want to logout?')) return;
        await supabaseClient.auth.signOut();
        setCustomerAuthState(null);
        document.getElementById('userDropdown').classList.remove('open');
        showToast('Logged out successfully.', 'warning');
    };

    async function restoreCustomerSession() {
        try {
            const { data } = await supabaseClient.auth.getSession();
            if (!data.session?.user) return;
            const profile = await getCustomerProfile(data.session.user);
            setCustomerAuthState(profile);
        } catch (error) {
            console.error('Customer session restore error:', error);
            await supabaseClient.auth.signOut().catch(() => {});
            setCustomerAuthState(null);
            showToast(error.message || 'Customer session could not be restored.', 'error');
        }
    }

    supabaseClient.auth.onAuthStateChange((event, session) => {
        if (event === 'SIGNED_OUT') setCustomerAuthState(null);
        if (event === 'SIGNED_IN' && session?.user) {
            window.setTimeout(restoreCustomerSession, 0);
        }
    });
    restoreCustomerSession();
})();
</script>
